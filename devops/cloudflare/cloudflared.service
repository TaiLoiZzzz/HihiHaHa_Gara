[Unit]
Description=Cloudflare Tunnel Daemon for HiHiHaHa Auto
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --config /etc/cloudflared/config.yml
Restart=always
RestartSec=5s
TimeoutStartSec=0
LimitNOFILE=65536

# Security sandbox
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
