# ==============================================================================
# HIHIHAHA AUTO GARAGE - MASTER ENVIRONMENT TEMPLATE
# Copy to backend/.env and client/.env.local respectively
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=https://hihihahagara.quachtailoi.id.vn,http://localhost:8888,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. POLYGLOT DATABASES CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL (ACID - Users, RBAC, Customer Accounts)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=hihihaha_db
PG_SSL=false
PG_MAX_POOL=20

# MongoDB (Document Store - Work Orders, Estimates, Checklists)
MONGO_URI=mongodb://localhost:27017/hihihaha_db
MONGO_MAX_POOL_SIZE=50

# Neo4j (Graph Database - AI Diagnostics, Fault Tree, Part Relations)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456

# Redis (In-memory Store - Cache, Distributed Lock Redlock, Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=hihihaha_super_secret_jwt_key_2026_secured
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (VNPAY SANDBOX / PRODUCTION)
# ------------------------------------------------------------------------------
VNP_TMN_CODE=TEST_CODE
VNP_HASH_SECRET=TEST_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://hihihahagara.quachtailoi.id.vn/api/v1/payment/vnpay_return

# ------------------------------------------------------------------------------
# 5. MAILER & NOTIFICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hihihaha.service@gmail.com
SMTP_PASS=app_password_here
EMAIL_FROM=HIHIHAHA AUTO <hihihaha.service@gmail.com>

# ------------------------------------------------------------------------------
# 6. CLIENT-SIDE NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
INTERNAL_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_GARAGE_NAME=HIHIHAHA AUTO - TRUNG TÂM DỊCH VỤ 4S
NEXT_PUBLIC_HOTLINE=0797 526 990
