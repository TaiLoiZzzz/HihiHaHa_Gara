# ==============================================================================
# HIHIHAHA AUTO GARAGE - PRODUCTION ENVIRONMENT BLUEPRINT
# Set with real credentials on the production server / CI/CD secrets
# ==============================================================================

NODE_ENV=production
PORT=5000
INTERNAL_BACKEND_URL=http://backend:5000

# PostgreSQL Credentials (Docker internal network)
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD_2026
PG_DATABASE=hihihaha_db

# MongoDB
MONGO_URI=mongodb://mongodb:27017/hihihaha_db

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_NEO4J_PASSWORD_2026

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptography & Token Signatures
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_KEY_FOR_PRODUCTION
JWT_EXPIRES_IN=7d

# Domain & Web URLs
CORS_ORIGIN=https://hihihahagara.quachtailoi.id.vn
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=https://hihihahagara.quachtailoi.id.vn

# VNPay Production Credentials
VNP_TMN_CODE=PRODUCTION_MERCHANT_CODE
VNP_HASH_SECRET=PRODUCTION_HASH_SECRET
VNP_URL=https://pay.vnpay.vn/vpcpay.html
VNP_RETURN_URL=https://hihihahagara.quachtailoi.id.vn/customer/payment/vnpay_return

# Grafana Monitoring Credentials
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_2026
